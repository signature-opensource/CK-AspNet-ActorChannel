<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Binds the connections of the application-wide WebSocket channel to their actor, so that a feature can push a typed message to every connection of a given user. The socket is anonymous and returns a connection identifier; the identity is bound afterwards by an authenticated Cris command carrying that identifier, so no token ever transits through the socket URL.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CK.Cris.Authentication" Version="3.0.0-0.cris-auth.0.ci.61" />
        <PackageReference Include="CK.Cris.Typescript" Version="3.0.0-0.cris-auth.0.ci.39" />
        <PackageReference Include="CK.AspNet.WebSocketChannel" Version="24.0.0-0.cris-auth.0.ci.6" />
        <PackageReference Include="CK.TS.AspNet.WebSocketChannel" Version="3.0.0-0.cris-auth.0.ci.10" />
    </ItemGroup>

</Project>
